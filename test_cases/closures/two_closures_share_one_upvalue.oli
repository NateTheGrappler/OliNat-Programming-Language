#pullf io

make int vault()
{
    make int balance = 0;

    make empty deposit(int amount)
    {
        balance += amount;
    }
    make empty withdraw(int amount)
    {
        if (amount > balance)
        {
            println("declined");
        }
        else
        {
            balance -= amount;
        }
    }

    deposit(100);
    deposit(50);
    withdraw(30);
    withdraw(5000);
    return balance;
}
println(vault());
