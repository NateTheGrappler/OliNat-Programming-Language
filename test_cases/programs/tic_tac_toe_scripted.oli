#pullf stdlib

make string winner(string[] b)
{
    make int[] lines = [0, 1, 2,  3, 4, 5,  6, 7, 8,
                        0, 3, 6,  1, 4, 7,  2, 5, 8,
                        0, 4, 8,  2, 4, 6];
    for (make int i = 0; i < 24; i += 3)
    {
        make string first = b[lines[i]];
        if (first != "." and first == b[lines[i + 1]] and first == b[lines[i + 2]])
        {
            return first;
        }
    }
    return "none";
}

make empty show(string[] b)
{
    for (make int row = 0; row < 3; row++)
    {
        println(b[row * 3] + b[row * 3 + 1] + b[row * 3 + 2]);
    }
}

make string[] board = [".", ".", ".", ".", ".", ".", ".", ".", "."];
make int[] moves = [4, 0, 2, 8, 6, 1, 3];
make string result = "none";
make int turns = 0;

for (make int m = 0; m < length(moves); m++)
{
    if (result == "none")
    {
        make string player = "O";
        if (m - (m / 2) * 2 == 0)
        {
            player = "X";
        }
        board[moves[m]] = player;
        turns++;
        result = winner(board);
    }
}

show(board);
println(result + " wins after " + intToStr(turns) + " moves");
